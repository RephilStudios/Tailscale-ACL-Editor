{
	"tagOwners": {
		"tag:ai-agent": ["autogroup:admin"],
	},

	"acls": [
		// 1. THE "NORMAL" RULE:
		// You and the Proxmox server are "Members". This lets you talk
		// to each other exactly like a normal network.
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:member:*"],
		},

		// 2. THE ADMIN RULE:
		// Ensures YOU (the admin) can always reach into the VM's cage
		// to use SPICE, VNC, and SSH.
		{
			"action": "accept",
			"src":    ["autogroup:admin"],
			"dst":    ["tag:ai-agent:*"],
		},

		// 3. THE CAGE:
		// The VM can ONLY talk to Ollama. It can't see your laptop,
		// it can't see your phone, and it can't see the Proxmox web UI.
		{
			"action": "accept",
			"src":    ["tag:ai-agent"],
			"dst":    ["100.106.252.1:11434", "100.106.252.1:9000"],
		},
	],

	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:admin"],
			"dst":    ["autogroup:self", "tag:ai-agent"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
}
